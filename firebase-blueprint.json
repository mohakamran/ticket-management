{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user in the system with a role.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["ADMIN", "EMPLOYEE"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "role", "createdAt"]
    },
    "Ticket": {
      "title": "Ticket",
      "description": "A support ticket or task.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "IN_PROGRESS", "COMPLETED"] },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "assignedToId": { "type": "string" },
        "createdById": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "status", "priority", "createdById", "createdAt", "updatedAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment left on a ticket.",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "userId": { "type": "string" },
        "ticketId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["message", "userId", "ticketId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles and roles."
    },
    "/tickets/{ticketId}": {
      "schema": { "$ref": "Ticket" },
      "description": "Main ticket collection."
    },
    "/tickets/{ticketId}/comments/{commentId}": {
      "schema": { "$ref": "Comment" },
      "description": "Comments associated with a specific ticket."
    }
  }
}
